<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Unterm"
    Manufacturer="Alex"
    Version="0.71.4"
    UpgradeCode="2B17738E-D6E7-44BB-9B55-1D6AF31404A2"
    Scope="perMachine">

    <SummaryInformation
      Description="Unterm terminal"
      Manufacturer="Alex" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Unterm is already installed." />
    <!-- Force every file in the package onto disk, whatever is there already.
         The WezTerm-era releases stamped unterm.exe as FILEVERSION 1.0.0.0;
         next-core stamps the real 0.x. To Windows Installer 1.0.0.0 is the
         NEWER file, so an upgrade from 0.57.4 skipped copying unterm.exe and
         then removed the old one with the old product: an install with no
         terminal in it. 'a' overrides that version comparison; without it any
         upgrade across the kernel boundary ships a folder of DLLs and no exe. -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <!-- Close what is holding the files, rather than asking the user to.
         An install is interactive (WixUI_Minimal below), so a locked file
         means Restart Manager shows "the following applications should be
         closed" and stops. Quitting the window is not enough to clear it:
         unterm-core.exe is spawned detached so sessions survive a window
         closing, and unterm-cli.exe is what an agent's MCP bridge runs, held
         open by whichever editor spawned it. Neither has a window to close,
         so the user is asked to close something they cannot see and the
         install fails however many times they try.

         TerminateProcess rather than a close message: the two helpers have no
         message loop to receive one, and by this point the user has already
         agreed to install over them. -->
    <util:CloseApplication
      Id="CloseUntermGui"
      Target="unterm.exe"
      CloseMessage="yes"
      TerminateProcess="1"
      RebootPrompt="no" />
    <util:CloseApplication
      Id="CloseUntermCore"
      Target="unterm-core.exe"
      TerminateProcess="1"
      RebootPrompt="no" />
    <util:CloseApplication
      Id="CloseUntermCli"
      Target="unterm-cli.exe"
      TerminateProcess="1"
      RebootPrompt="no" />
    <MediaTemplate EmbedCab="yes" />

    <!-- WixUI_Minimal gives the user a small wizard: Welcome → License →
         Install → Finish. Without this the MSI runs *silently* — double-click
         and "nothing happens" because there is no progress dialog or
         finish screen. v0.5.1 shipped without UI by accident; users saw the
         installer flash and disappear. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

    <Feature Id="MainFeature" Title="Unterm" Level="1">
      <ComponentGroupRef Id="UntermFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ExplorerContextMenu" />
      <!-- Built by unzoo-one's `npm run build:static`; ci\build-msi.ps1 sets
           ConsoleStaged=1 once it has copied it into the staging folder. -->
      <?if $(var.ConsoleStaged) = "1" ?>
      <ComponentGroupRef Id="ConsoleFiles" />
      <?endif?>
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Unterm">
        <Directory Id="DefaultsFolder" Name="defaults" />
        <Directory Id="AssetsFolder" Name="assets">
          <Directory Id="BundledFontsFolder" Name="fonts" />
        </Directory>
        <!-- Mesa software-GL is x64-only; no arm64 prebuilt exists. -->
        <?if $(sys.BUILDARCH) != "arm64" ?>
        <Directory Id="MesaFolder" Name="mesa" />
        <?endif?>
        <?if $(var.ConsoleStaged) = "1" ?>
        <Directory Id="ConsoleFolder" Name="console" />
        <?endif?>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Unterm" />
    </StandardDirectory>

    <ComponentGroup Id="UntermFiles" Directory="INSTALLFOLDER">
      <Component Id="UntermExe" Guid="9A7EA657-4A0E-42B0-9974-0A77B4DD7FD0">
        <File Id="UntermExeFile" Source="$(var.SourceDir)\unterm.exe" KeyPath="yes" />
      </Component>
      <Component Id="UntermCliExe" Guid="2C81E2F0-2E83-4B73-9F1B-5C4A7B3C7CE0">
        <File Source="$(var.SourceDir)\unterm-cli.exe" KeyPath="yes" />
      </Component>
      <!-- The engine daemon. The GUI and CLI spawn it from beside their own
           executable (ensure_running); an install without it silently falls
           back to the in-process engine and none of the Core architecture
           ships. -->
      <Component Id="UntermCoreExe" Guid="BCD96CCA-CC3A-4BD3-B518-90C1B32A02C0">
        <File Source="$(var.SourceDir)\unterm-core.exe" KeyPath="yes" />
      </Component>
      <Component Id="ConptyDll" Guid="E32B8E38-04D9-44C4-B06B-FE97D2E7CC20">
        <File Source="$(var.SourceDir)\conpty.dll" KeyPath="yes" />
      </Component>
      <Component Id="LibEglDll" Guid="5E30B910-8558-432F-9BD0-B01D55913D94">
        <File Source="$(var.SourceDir)\libEGL.dll" KeyPath="yes" />
      </Component>
      <Component Id="LibGlesDll" Guid="81E1F3B1-5941-4F59-B9A3-B7C72A12FC3E">
        <File Source="$(var.SourceDir)\libGLESv2.dll" KeyPath="yes" />
      </Component>
      <Component Id="OpenConsoleExe" Guid="31E6F6F2-74DE-4576-BC35-3E4D2E66E84F">
        <File Source="$(var.SourceDir)\OpenConsole.exe" KeyPath="yes" />
      </Component>
      <!-- Explorer right-click: "Open Unterm here" on folders and folder
           backgrounds (Warp/WT parity). %V = the clicked directory. -->
      <Component Id="ExplorerContextMenuDir" Guid="9E84F984-1E7A-4655-ACBE-E689E76E2AB8">
        <RegistryKey Root="HKCR" Key="Directory\shell\Unterm">
          <RegistryValue Type="string" Value="Open Unterm here" KeyPath="yes" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLFOLDER]unterm.exe" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]unterm.exe&quot; start --cwd &quot;%V&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
      <Component Id="ExplorerContextMenuBg" Guid="D26416CF-817A-4DCE-8F8C-FFA87951EA5D">
        <RegistryKey Root="HKCR" Key="Directory\Background\shell\Unterm">
          <RegistryValue Type="string" Value="Open Unterm here" KeyPath="yes" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLFOLDER]unterm.exe" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]unterm.exe&quot; start --cwd &quot;%V&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
      <!-- The tab variant: hand the directory to the window already open
           (macOS has had this via FinderSync all along). unterm.exe is the
           GUI-subsystem binary, so no console flashes; with no live window
           the tab flag degrades to a plain open. -->
      <Component Id="ExplorerContextMenuTabDir" Guid="05DC0654-0A98-4504-B9E0-E81BF3E7B054">
        <RegistryKey Root="HKCR" Key="Directory\shell\UntermTab">
          <RegistryValue Type="string" Value="Open in Unterm tab" KeyPath="yes" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLFOLDER]unterm.exe" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]unterm.exe&quot; start --tab --cwd &quot;%V&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
      <Component Id="ExplorerContextMenuTabBg" Guid="31206D1C-EBEC-4950-805C-AC0315CE4DF9">
        <RegistryKey Root="HKCR" Key="Directory\Background\shell\UntermTab">
          <RegistryValue Type="string" Value="Open in Unterm tab" KeyPath="yes" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLFOLDER]unterm.exe" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]unterm.exe&quot; start --tab --cwd &quot;%V&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
      <Component Id="DefaultUntermConf" Directory="DefaultsFolder" Guid="F3B2F196-E64A-4045-8B40-490D18018546">
        <File Source="$(var.SourceDir)\defaults\unterm.conf" KeyPath="yes" />
      </Component>
      <Component Id="UntermSymbolsFont" Directory="BundledFontsFolder" Guid="E0B09A5B-7181-4F57-AF46-CF1997CC0ED8">
        <File Source="$(var.SourceDir)\assets\fonts\SymbolsNerdFontMono-Regular.ttf" KeyPath="yes" />
      </Component>
      <Component Id="UntermEmojiFont" Directory="BundledFontsFolder" Guid="C0C4F2E0-0A6C-4410-9CC0-1E59D628BFFD">
        <File Source="$(var.SourceDir)\assets\fonts\NotoColorEmoji.ttf" KeyPath="yes" />
      </Component>
      <!-- The default terminal font, opened by file name (terminal.rs); an
           install without it silently degrades to the system monospace. -->
      <Component Id="UntermDefaultFont" Directory="BundledFontsFolder" Guid="AB4845EF-3F42-48A6-868C-33FB1F840C11">
        <File Source="$(var.SourceDir)\assets\fonts\JetBrainsMono-Regular.ttf" KeyPath="yes" />
      </Component>
      <!-- x64-only: arm64 has no Mesa software-GL fallback (ANGLE is primary). -->
      <?if $(sys.BUILDARCH) != "arm64" ?>
      <Component Id="MesaOpenGlDll" Directory="MesaFolder" Guid="6E9F2F00-7795-4D4B-B910-660306DC1220">
        <File Source="$(var.SourceDir)\mesa\opengl32.dll" KeyPath="yes" />
      </Component>
      <?endif?>
    </ComponentGroup>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="235E0638-8150-4871-BF45-3914E77D5DF2">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="Unterm"
          Description="Launch Unterm"
          Target="[INSTALLFOLDER]unterm.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\Unzoo AI\Unterm"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ExplorerContextMenu" Guid="DABEE42D-469F-4509-9F22-6F5C0A7452F6">
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Directory\shell\Unterm"
          Type="string"
          Value="Open in Unterm"
          KeyPath="yes" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Directory\shell\Unterm"
          Name="Icon"
          Type="string"
          Value="[INSTALLFOLDER]unterm.exe" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Directory\shell\Unterm\command"
          Type="string"
          Value="&quot;[INSTALLFOLDER]unterm.exe&quot; start --cwd &quot;%1&quot;" />

        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Directory\Background\shell\Unterm"
          Type="string"
          Value="Open in Unterm" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Directory\Background\shell\Unterm"
          Name="Icon"
          Type="string"
          Value="[INSTALLFOLDER]unterm.exe" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Classes\Directory\Background\shell\Unterm\command"
          Type="string"
          Value="&quot;[INSTALLFOLDER]unterm.exe&quot; start --cwd &quot;%V&quot;" />
      </Component>
    </DirectoryRef>

    <!-- The console's file names carry content hashes that change on every
         front-end build, so they are harvested rather than listed. Anything
         under the staged console\ directory ships as-is. -->
    <?if $(var.ConsoleStaged) = "1" ?>
    <ComponentGroup Id="ConsoleFiles" Directory="ConsoleFolder">
      <Files Include="$(var.SourceDir)\console\**" />
    </ComponentGroup>
    <?endif?>
  </Package>
</Wix>
