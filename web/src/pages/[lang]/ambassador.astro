---
import Base from "../../layouts/Base.astro";
import Ambassador from "../../components/Ambassador.astro";
import { LOCALES, alternatesFor } from "../../i18n/locales";
import { DICTS, NON_DEFAULT_LANGS } from "../../i18n/dicts";
import enUS from "../../i18n/en-US.json";

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const dict = DICTS[lang as string];
const pathPrefix = `/${lang}`;
const t = (k: string) => dict[k] ?? (enUS as Record<string, string>)[k] ?? k;

---

<Base
  lang={lang as string}
  dict={dict}
  alternates={alternatesFor("/ambassador")}
  locales={LOCALES}
  pathPrefix={pathPrefix}
  seo={{ title: t("amb.meta.title"), description: t("amb.meta.desc"), canonicalPath: `${pathPrefix}/ambassador`, xDefault: "https://unterm.app/ambassador" }}
>
  <Ambassador dict={dict} pathPrefix={pathPrefix} />
</Base>
