---
import Base from "../../layouts/Base.astro";
import Guide from "../../components/Guide.astro";
import { LOCALES, alternatesFor } from "../../i18n/locales";
import { DICTS, NON_DEFAULT_LANGS } from "../../i18n/dicts";
import enUS from "../../i18n/en-US.json";

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const dict = DICTS[lang as string];
const pathPrefix = `/${lang}`;
const t = (k: string) => dict[k] ?? (enUS as Record<string, string>)[k] ?? k;

---

<Base
  lang={lang as string}
  dict={dict}
  alternates={alternatesFor("/guide")}
  locales={LOCALES}
  pathPrefix={pathPrefix}
  seo={{ title: t("guide.meta.title"), description: t("guide.meta.desc"), canonicalPath: `${pathPrefix}/guide`, xDefault: "https://unterm.app/guide" }}
>
  <Guide dict={dict} pathPrefix={pathPrefix} />
</Base>
