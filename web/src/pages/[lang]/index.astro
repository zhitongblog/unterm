---
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import { LOCALES, alternates } from "../../i18n/locales";
import { DICTS, NON_DEFAULT_LANGS } from "../../i18n/dicts";
import { fetchStats } from "../../lib/stats";

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const dict = DICTS[lang as string];
const pathPrefix = `/${lang}`;
const stats = await fetchStats();
---

<Base
  lang={lang as string}
  dict={dict}
  alternates={alternates()}
  locales={LOCALES}
  pathPrefix={pathPrefix}
>
  <Home dict={dict} pathPrefix={pathPrefix} stats={stats} />
</Base>
