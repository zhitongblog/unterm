---
// Base layout: <html>, <head>, sticky nav, footer, slot for the page body.
//
// Each translated page passes:
//   - lang        the BCP-47 locale code, e.g. "zh-CN"
//   - dict        the loaded translation object (already filtered to that lang)
//   - alternates  array of {code, href} for hreflang link tags
//
// The nav language picker is server-rendered as a real <form> + <select>: a
// change submits to the corresponding /<code>/ URL via <option data-href>,
// no JS framework needed. (Tiny inline script handles the select->navigate.)

interface Locale {
  code: string;
  name: string;
  href: string;
}

interface Props {
  lang: string;
  dict: Record<string, string>;
  alternates: { code: string; href: string }[];
  locales: Locale[];
  pathPrefix: string; // "" for en, "/zh-CN" for others
  // Optional per-page SEO overrides. When omitted, the layout renders the
  // home page's title / description / canonical / structured data exactly as
  // before (zero regression). Sub-pages such as /compare/<slug> pass their
  // own so each ranks for its own query.
  seo?: {
    title?: string;
    description?: string;
    /** Full site-absolute path of THIS page, e.g. "/compare/warp" or
     *  "/zh-CN/compare/warp". Drives <link rel=canonical> + og:url. */
    canonicalPath?: string;
    /** Replaces the default home JSON-LD graph when provided. */
    jsonLd?: unknown[];
    /** x-default hreflang target (defaults to the site root). */
    xDefault?: string;
  };
}

const { lang, dict, alternates, locales, pathPrefix, seo } = Astro.props as Props;
import enUS from "../i18n/en-US.json";

const t = (k: string) => dict[k] ?? enUS[k] ?? k;
const metaTitle = seo?.title ?? t("meta.title");
const metaDesc = seo?.description ?? t("meta.desc");
const canonical = seo?.canonicalPath
  ? `https://unterm.app${seo.canonicalPath}`
  : `https://unterm.app${pathPrefix || "/"}`;
const xDefaultHref = seo?.xDefault ?? "https://unterm.app/";

// og:locale wants underscore form (en_US, zh_CN). Build the active locale +
// every other locale as og:locale:alternate so each translated page declares
// its siblings to social / answer-engine crawlers.
const ogLocale = lang.replace("-", "_");
const ogAltLocales = alternates
  .map((a) => a.code.replace("-", "_"))
  .filter((c) => c !== ogLocale);

// ?v= busts the Cloudflare edge cache (assets/* carries max-age=86400,
// so the bare URL can keep serving the previous card for up to a day
// after a deploy). Bump it whenever og.png is regenerated.
const ogImage = "https://unterm.app/assets/og.png?v=0.71.6";

// Structured data (SEO rich results + GEO / answer-engine extraction).
// SoftwareApplication is the primary entity; WebSite + Organization give
// crawlers the publisher graph. Rendered once per page in <head>.
const defaultJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Unterm",
    alternateName: "Unterm — the terminal AI agents can drive",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
    softwareVersion: "0.71.6",
    url: "https://unterm.app/",
    downloadUrl: "https://github.com/zhitongblog/unterm/releases/latest",
    description: t("meta.desc"),
    license: "https://opensource.org/licenses/MIT",
    image: ogImage,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    author: { "@type": "Person", name: "Alex Lee" },
    publisher: { "@type": "Organization", name: "Unzoo", url: "https://unterm.app/" },
    sameAs: ["https://github.com/zhitongblog/unterm"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Unterm",
    url: "https://unterm.app/",
    description: t("meta.desc"),
    inLanguage: lang,
  },
];
const jsonLd = seo?.jsonLd ?? defaultJsonLd;
---

<!doctype html>
<html lang={lang} class="bg-notion-bg scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.code} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <meta name="theme-color" content="#10b981" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Unterm" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={metaTitle} />
    <meta property="og:locale" content={ogLocale} />
    {ogAltLocales.map((c) => (
      <meta property="og:locale:alternate" content={c} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={metaTitle} />

    {jsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icon-32.png?v=0.71.6" />
    <link rel="icon" type="image/png" sizes="256x256" href="/assets/icon-256.png?v=0.71.6" />
    <link rel="icon" type="image/svg+xml" href="/assets/icon.svg?v=0.71.6" />

    <!-- Cloudflare Web Analytics (privacy-first, no cookies) -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "6daea7bd6ed24e82a9f3b5463dbcc3f0"}'
    ></script>
  </head>
  <body class="bg-notion-bg text-notion-ink antialiased font-sans">

    <!-- ============== NAV ============== -->
    <header class="sticky top-0 z-30 backdrop-blur bg-notion-bg/80 border-b border-notion-border">
      <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
        <a href={pathPrefix + "/"} class="flex items-center gap-2 group">
          <img src="/assets/icon.svg?v=0.71.6" alt="" width="28" height="28" />
          <span class="font-semibold tracking-tight text-notion-ink group-hover:text-white">Unterm</span>
          <span class="text-xs font-mono text-notion-faint hidden sm:inline">v0.71.6</span>
        </a>
        <nav class="hidden md:flex items-center gap-5 text-sm text-notion-muted">
          <a href={pathPrefix + "/#agents"} class="hover:text-notion-teal text-notion-teal">{t("nav.agents")}</a>
          <a href={pathPrefix + "/#capabilities"} class="hover:text-notion-ink">{t("nav.capabilities")}</a>
          <a href={pathPrefix + "/#features"} class="hover:text-notion-ink">{t("nav.features")}</a>
          <a href={pathPrefix + "/#demo"} class="hover:text-notion-ink">{t("nav.demo")}</a>
          <a href={pathPrefix + "/#principles"} class="hover:text-notion-ink">{t("nav.principles")}</a>
          <a href={pathPrefix + "/#compare"} class="hover:text-notion-ink">{t("nav.compare")}</a>
          <a href="/docs/agent-integration" class="hover:text-notion-ink">{t("nav.docs")}</a>
          <a href={pathPrefix + "/#install"} class="hover:text-notion-ink">{t("nav.install")}</a>
          <a href={pathPrefix + "/#faq"} class="hover:text-notion-ink">{t("nav.faq")}</a>
          <a href={pathPrefix + "/#sponsor"} class="hover:text-rose-300"><span class="text-rose-400">♥</span> {t("nav.sponsor")}</a>
        </nav>
        <div class="flex items-center gap-3">
          <select id="lang-picker"
                  class="text-xs bg-notion-surface border border-notion-border rounded px-2 py-1 text-notion-ink focus:outline-none focus:border-notion-borderStrong">
            {locales.map((l) => (
              <option value={l.href} selected={l.code === lang}>{l.name}</option>
            ))}
          </select>
          <a href="https://github.com/zhitongblog/unterm" target="_blank" rel="noopener"
             class="text-notion-muted hover:text-notion-ink" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.8 10.9.6.1.8-.2.8-.6V20c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2.9-.3 2-.4 3-.4s2.1.1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.7.8 1.2 1.9 1.2 3.2 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.5-1.5 7.8-5.8 7.8-10.9C23.5 5.7 18.3.5 12 .5z"/>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <!-- ============== FOOTER ============== -->
    <footer class="border-t border-notion-border py-12 mt-10">
      <div class="max-w-6xl mx-auto px-6 space-y-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div class="flex items-center gap-2 text-notion-faint text-sm">
            <img src="/assets/icon.svg?v=0.71.6" alt="" width="20" height="20" />
            <span class="font-semibold text-notion-ink">Unterm</span>
            <span>{t("footer.tag")}</span>
          </div>
          <div class="flex flex-wrap items-center gap-5 text-sm text-notion-faint">
            <a href="https://github.com/zhitongblog/unterm" target="_blank" rel="noopener" class="hover:text-notion-ink">GitHub</a>
            <a href="https://github.com/zhitongblog/unterm/releases" target="_blank" rel="noopener" class="hover:text-notion-ink">{t("footer.releases")}</a>
            <a href="/changelog" class="hover:text-notion-ink">{t("footer.changelog")}</a>
            <a href="/docs/agent-integration" class="hover:text-notion-ink">{t("footer.docs")}</a>
            <a href="https://github.com/zhitongblog/unterm/blob/master/LICENSE.md" target="_blank" rel="noopener" class="hover:text-notion-ink">{t("footer.license")}</a>
            <a href="https://doaipm.com" target="_blank" rel="noopener" class="hover:text-notion-ink">doaipm</a>
            <span>{t("footer.copy")}</span>
          </div>
        </div>
        <!-- SoloMD-style tech-stack callout: a single line at the very bottom
             that signals "this is what's actually under the hood." Helps
             ship engineers get a quick read on whether to read the source. -->
        <div class="text-center text-xs text-notion-faint font-mono pt-4 border-t border-notion-border/60">
          {t("footer.stack")}
        </div>
      </div>
    </footer>

    <script is:inline>
      // Tiny non-framework lang picker — no Alpine needed.
      const sel = document.getElementById("lang-picker");
      if (sel) {
        sel.addEventListener("change", (e) => {
          const href = e.target.value;
          if (href) window.location.assign(href);
        });
      }

      // Layer 3 of the stats stack: live-refresh the star/download chips.
      //
      // Why this exists, even though Astro already SSR'd numbers into the
      // HTML: the build only runs on push to master, which can be days or
      // weeks ago. /api/stats is a Pages Function that proxies GitHub on
      // a 5-minute edge cache, so a regular visitor still sees today's
      // count without us redeploying.
      //
      // Two footguns guarded against:
      //   1. We update only when the answer is > 0. A null response
      //      (proxy failure) leaves the SSR text alone — never overwrite
      //      a real number with "—" or 0.
      //   2. We swallow all errors silently. If /api/stats is down, the
      //      page just keeps showing the build-time numbers; users never
      //      see "loading..." flicker or a thrown promise.
      (function () {
        function fmt(n) {
          if (n === null || !Number.isFinite(n)) return "—";
          if (n < 1000) return String(n);
          if (n < 10000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "k";
          if (n < 1000000) return Math.round(n / 1000) + "k";
          return (n / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
        }
        function paint(key, value) {
          if (typeof value !== "number" || value <= 0) return;
          document
            .querySelectorAll('[data-stat="' + key + '"]')
            .forEach((el) => {
              el.textContent = fmt(value);
            });
        }
        fetch("/api/stats", { headers: { accept: "application/json" } })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            if (!d) return;
            paint("stars", d.stars);
            paint("downloads", d.downloads);
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
