        <div class="flex items-center justify-between gap-2">
          <span class="text-xs font-mono text-rose-300 bg-rose-500/10 border border-rose-500/25 px-2 py-0.5 rounded">
            {isZhCN ? "痛点 03 · Windows 后台狂闪黑窗与 Ctrl+C 崩服务" : "PAIN 03 · WINDOWS CONSOLE FLASHES & CTRL+C CRASHES"}
