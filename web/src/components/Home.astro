<script is:inline>
  (function () {
    const tabs = document.querySelectorAll(".install-tab");
    const panes = document.querySelectorAll(".install-pane");
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        tabs.forEach((x) => {
          const on = x === tab;
          x.classList.toggle("text-notion-ink", on);
          x.classList.toggle("bg-notion-sunken/60", on);
          x.classList.toggle("text-notion-muted", !on);
        });
        panes.forEach((p) => p.classList.toggle("hidden", p.dataset.pane !== tab.dataset.tab));
      })
    );
    document.querySelectorAll(".install-pane pre").forEach((pre) => {
      pre.style.cursor = "copy";
      pre.title = "click to copy";
      pre.addEventListener("click", async () => {
        const text = pre.textContent.trim();
        const code = pre.querySelector("code") || pre;
        try { await navigator.clipboard.writeText(text); } catch (_) { return; }
        const original = code.textContent;
        code.textContent = "✓ copied";
        setTimeout(() => { code.textContent = original; }, 1100);
      });
    });
  })();
</script>
