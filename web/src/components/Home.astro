        <span>{t("hero.cta.download")}</span>
      </a>
      <a href={`/api/download?v=${release.tag}&mirror=atomgit`}
         class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-notion-surface hover:bg-notion-sunken border border-notion-green/40 hover:border-notion-teal text-notion-teal font-medium transition">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 4v12m0 0l-4-4m4 4l4-4M5 20h14"/></svg>
        <span>{isZhCN ? "🇨🇳 国内高速直链下载" : "🇨🇳 China Mirror Download"}</span>
