          <summary class="cursor-pointer flex items-center justify-between px-5 py-4 hover:bg-notion-surface select-none">
            <span class="font-medium pr-4">{t(q.q)}</span>
            <svg class="w-4 h-4 shrink-0 text-notion-faint group-open:rotate-180 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="px-5 pb-5 text-sm text-notion-muted leading-relaxed" set:html={t(q.a)}></p>
        </details>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href={pathPrefix + "/features"} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-notion-border hover:border-notion-borderStrong text-notion-ink transition">{t("home.features.cta")} →</a>
    </div>
    <p class="mt-10 text-center text-sm text-notion-muted">
      {t("home.amb")}
      <a href={pathPrefix + "/ambassador"} class="text-notion-teal hover:underline">{t("home.amb_cta")} →</a>
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll(".install-tab");
    const panes = document.querySelectorAll(".install-pane");
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        tabs.forEach((x) => {
          const on = x === tab;
          x.classList.toggle("text-notion-ink", on);
          x.classList.toggle("bg-notion-sunken/60", on);
          x.classList.toggle("text-notion-muted", !on);
        });
        panes.forEach((p) => p.classList.toggle("hidden", p.dataset.pane !== tab.dataset.tab));
      })
    );
    document.querySelectorAll(".install-pane pre").forEach((pre) => {
      pre.style.cursor = "copy";
      pre.title = document.getElementById("install")?.dataset.copyHint || "click to copy";
      pre.addEventListener("click", async () => {
        const text = pre.textContent.trim();
        const code = pre.querySelector("code") || pre;
        try { await navigator.clipboard.writeText(text); } catch (_) { return; }
        const original = code.textContent;
        code.textContent = "✓ copied";
        setTimeout(() => { code.textContent = original; }, 1100);
      });
    });

    const themeBtns = document.querySelectorAll("[data-theme-btn]");
    themeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        try {
          const th = JSON.parse(btn.getAttribute("data-theme-json") || "{}");
          if (!th.id) return;
          themeBtns.forEach((b) => {
            const on = b === btn;
            b.className = "theme-pill inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-xs font-mono border transition " +
              (on ? "bg-sky-500/15 border-sky-400 text-sky-200 shadow-sm" : "bg-notion-surface/60 border-notion-border text-notion-muted hover:text-notion-ink hover:border-notion-borderStrong");
          });
          const win = document.getElementById("live-theme-window");
          const top = document.getElementById("lt-topbar");
          const sb = document.getElementById("lt-statusbar");
          const actTab = document.getElementById("lt-active-tab");
          const tabDot = document.getElementById("lt-tab-dot");
          const tabBadge = document.getElementById("lt-tab-badge");
          const thTag = document.getElementById("lt-theme-tag");
          const pAct = document.getElementById("lt-pane-active");
          const pBar = document.getElementById("lt-pane-bar");
          const pDim = document.getElementById("lt-pane-dim");
          const p1Hdr = document.getElementById("lt-pane1-hdr");
          const p2Hdr = document.getElementById("lt-pane2-hdr");
          const p1Title = document.getElementById("lt-pane1-title");
          const p2Title = document.getElementById("lt-pane2-title");
          const sparkle = document.getElementById("lt-sparkle");
          const actPill = document.getElementById("lt-active-pill");
          const dimPill = document.getElementById("lt-dim-pill");
          const code1 = document.getElementById("lt-code-1");
          const code2 = document.getElementById("lt-code-2");
          const cAccent = document.getElementById("lt-c-accent");
          const cMuted = document.getElementById("lt-c-muted");
          const cAmber = document.getElementById("lt-c-amber");
          const cPurple = document.getElementById("lt-c-purple");
          const cGreen = document.getElementById("lt-c-green");
          const sbLeft = document.getElementById("lt-sb-left");
          const sbAgent = document.getElementById("lt-sb-agent");
          const sbTheme = document.getElementById("lt-sb-theme");

          if (win) { win.style.background = th.bg; win.style.borderColor = th.border; }
          if (top) { top.style.background = th.chrome; top.style.borderColor = th.border; top.style.color = th.text; }
          if (sb) { sb.style.background = th.chrome; sb.style.borderColor = th.border; sb.style.color = th.muted; }
          if (actTab) { actTab.style.background = th.paneBg; actTab.style.borderColor = th.accent; }
          if (tabDot) { tabDot.style.background = th.accent; }
          if (tabBadge) { tabBadge.style.color = th.accent; tabBadge.style.background = th.isLight ? "rgba(2,132,199,0.12)" : "rgba(56,189,248,0.18)"; }
          if (thTag) { thTag.textContent = th.tag; thTag.style.borderColor = th.border; thTag.style.color = th.muted; }
          if (pAct) { pAct.style.background = th.paneBg; pAct.style.borderColor = th.accent; }
          if (pBar) { pBar.style.background = th.accent; }
          if (pDim) { pDim.style.background = th.paneDim; pDim.style.borderColor = th.border; }
          if (p1Hdr) { p1Hdr.style.borderColor = th.border; }
          if (p2Hdr) { p2Hdr.style.borderColor = th.border; }
          if (p1Title) { p1Title.style.color = th.text; }
          if (p2Title) { p2Title.style.color = th.muted; }
          if (sparkle) { sparkle.style.color = th.accent; }
          if (actPill) { actPill.style.borderColor = th.accent; actPill.style.color = th.accent; actPill.style.background = th.isLight ? "rgba(2,132,199,0.10)" : "rgba(56,189,248,0.15)"; }
          if (dimPill) { dimPill.style.borderColor = th.border; dimPill.style.color = th.muted; }
          if (code1) { code1.style.color = th.text; }
          if (code2) { code2.style.color = th.muted; }
          if (cAccent) { cAccent.style.color = th.accent; }
          if (cMuted) { cMuted.style.color = th.muted; }
          if (cAmber) { cAmber.style.color = th.amber; }
          if (cPurple) { cPurple.style.color = th.purple; }
          if (cGreen) { cGreen.style.color = th.green; }
          if (sbLeft) { sbLeft.style.color = th.text; }
          if (sbAgent) { sbAgent.style.color = th.accent; }
          if (sbTheme) { sbTheme.textContent = th.name; sbTheme.style.color = th.accent; }
        } catch (_) {}
      });
    });
  })();
</script>
