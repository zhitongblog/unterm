</section>

<!-- ============== FAQ ============== -->
<section id="faq" class="py-20 border-t border-notion-border">
  <div class="max-w-3xl mx-auto px-6">
    <h2 class="text-3xl font-semibold tracking-tight text-center">{t("faq.title")}</h2>
    <div class="mt-10 divide-y divide-zinc-800 border border-notion-border rounded-xl bg-notion-surface/40">
      {faq.map((q) => (
        <details class="group">
          <summary class="cursor-pointer flex items-center justify-between px-5 py-4 hover:bg-notion-surface select-none">
            <span class="font-medium pr-4">{t(q.q)}</span>
            <svg class="w-4 h-4 shrink-0 text-notion-faint group-open:rotate-180 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="px-5 pb-5 text-sm text-notion-muted leading-relaxed" set:html={t(q.a)}></p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ============== SPONSOR ============== -->
<!-- One developer, one project. Sponsor card cluster mirrors SoloMD's
     "Support" band — two named channels (GitHub Sponsors for monthly
     international, PayPal for one-tap worldwide) inline. Heavier "scan
     a QR code" payment paths (Alipay / WeChat Pay) intentionally not
     embedded — those are reserved for SoloMD (a higher-volume product)
     and would dilute the page for terminal-first audience here. -->
<section id="sponsor" class="py-20 border-t border-notion-border">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-semibold tracking-tight text-center">{t("sponsor.title")}</h2>
    <p class="mt-3 text-center text-notion-muted max-w-2xl mx-auto" set:html={t("sponsor.subtitle")}></p>
    <div class="mt-10 grid md:grid-cols-2 gap-4">
      {sponsors.map((s) => (
        <a href={s.href} target="_blank" rel="noopener"
           class="group block bg-notion-surface/40 hover:bg-notion-surface border border-notion-border hover:border-notion-borderStrong rounded-xl p-6 transition">
          <div class="flex items-center gap-2">
            <span class="text-2xl text-rose-400">{s.icon}</span>
            <span class="text-lg font-semibold text-notion-ink">{t(s.title)}</span>
          </div>
          <p class="mt-2 text-sm text-notion-muted leading-relaxed">{t(s.body)}</p>
          <div class="mt-3 text-xs text-notion-green group-hover:text-notion-teal font-mono">{t(s.cta)} →</div>
        </a>
      ))}
    </div>
    <p class="mt-6 text-center text-xs text-notion-faint" set:html={t("sponsor.note")}></p>
  </div>
</section>

<!-- ============== COMMUNITY ============== -->
<!-- Three contact channels in one row. SoloMD ends its long page with
     a similar "Support / contact" cluster; we adapt it as routing
     guidance: which channel for which type of question. The email is
     spelled out in the dict so user keeps it scrapeable but the
     surrounding copy frames it as last-resort. -->
<section id="community" class="py-20 border-t border-notion-border bg-notion-bg">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-semibold tracking-tight text-center">{t("community.title")}</h2>
    <p class="mt-3 text-center text-notion-muted max-w-2xl mx-auto">{t("community.subtitle")}</p>
    <div class="mt-12 grid md:grid-cols-3 gap-4">
      <a href="https://github.com/zhitongblog/unterm/issues" target="_blank" rel="noopener"
         class="group block bg-notion-surface/40 hover:bg-notion-surface border border-notion-border hover:border-notion-borderStrong rounded-xl p-6 transition">
        <div class="text-xl font-semibold">{t("community.github.title")}</div>
        <p class="mt-2 text-sm text-notion-muted leading-relaxed">{t("community.github.body")}</p>
        <div class="mt-3 text-xs text-notion-green group-hover:text-notion-teal font-mono">{t("community.github.cta")} →</div>
      </a>
      <a href="https://github.com/zhitongblog/unterm/discussions" target="_blank" rel="noopener"
         class="group block bg-notion-surface/40 hover:bg-notion-surface border border-notion-border hover:border-notion-borderStrong rounded-xl p-6 transition">
        <div class="text-xl font-semibold">{t("community.discussions.title")}</div>
        <p class="mt-2 text-sm text-notion-muted leading-relaxed">{t("community.discussions.body")}</p>
        <div class="mt-3 text-xs text-notion-green group-hover:text-notion-teal font-mono">{t("community.discussions.cta")} →</div>
      </a>
      <a href={`mailto:${t("community.email.cta")}`}
         class="group block bg-notion-surface/40 hover:bg-notion-surface border border-notion-border hover:border-notion-borderStrong rounded-xl p-6 transition">
        <div class="text-xl font-semibold">{t("community.email.title")}</div>
        <p class="mt-2 text-sm text-notion-muted leading-relaxed">{t("community.email.body")}</p>
        <div class="mt-3 text-xs text-notion-green group-hover:text-notion-teal font-mono">{t("community.email.cta")} →</div>
      </a>
    </div>
  </div>
</section>

