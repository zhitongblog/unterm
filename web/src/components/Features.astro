---
// All page sections wrapped into one component.
// The dict is passed in by the per-locale page entry; nothing here knows
// what the active language is, it just looks keys up in the dict.

import { formatCount, type Stats } from "../lib/stats";
import enUS from "../i18n/en-US.json";
import { COMPETITORS } from "../data/competitors";
import { resolveRelease } from "../lib/release";

interface Props {
  dict: Record<string, string>;
  pathPrefix: string;
  stats: Stats;
}

const { dict, pathPrefix, stats } = Astro.props as Props;
const t = (k: string) => dict[k] ?? enUS[k] ?? k;

const release = resolveRelease(stats);
const releaseTag = release.tag;
const releaseDate = release.date;

// FAQ entries — shape matches the keys inside the locale JSON.
const faq = [
  { q: "faq.what.q",        a: "faq.what.a" },
  // Cockpit-era questions (v0.55) — phrased the way people actually
  // search / ask an answer engine.
  { q: "faq.q1",            a: "faq.a1" },
  { q: "faq.q2",            a: "faq.a2" },
  { q: "faq.q3",            a: "faq.a3" },
  { q: "faq.q6",            a: "faq.a6" },
  { q: "faq.mouse.q",       a: "faq.mouse.a" },
  { q: "faq.mcp.q",         a: "faq.mcp.a" },
  { q: "faq.multi.q",       a: "faq.multi.a" },
  { q: "faq.warp.q",        a: "faq.warp.a" },
  { q: "faq.privacy.q",     a: "faq.privacy.a" },
  { q: "faq.telemetry.q",   a: "faq.telemetry.a" },
  { q: "faq.cost.q",        a: "faq.cost.a" },
  { q: "faq.size.q",        a: "faq.size.a" },
  { q: "faq.locale.q",      a: "faq.locale.a" },
  { q: "faq.agents_run.q",  a: "faq.agents_run.a" },
  { q: "faq.script.q",      a: "faq.script.a" },
  { q: "faq.platform.q",    a: "faq.platform.a" },
  { q: "faq.opensrc.q",     a: "faq.opensrc.a" },
  { q: "faq.contrib.q",     a: "faq.contrib.a" },
];

// Personas section — three columns, each with header + body + 4 bullets.
// The bullet keys follow the persona prefix so locale files can stay flat.
const personas = [
  {
    icon: "🤖",
    title: "persona.ai.title",
    body: "persona.ai.body",
    bullets: ["persona.ai.bullets.1", "persona.ai.bullets.2", "persona.ai.bullets.3", "persona.ai.bullets.4"],
  },
  {
    icon: "⚙️",
    title: "persona.ops.title",
    body: "persona.ops.body",
    bullets: ["persona.ops.bullets.1", "persona.ops.bullets.2", "persona.ops.bullets.3", "persona.ops.bullets.4"],
  },
  {
    icon: "🔧",
    title: "persona.power.title",
    body: "persona.power.body",
    bullets: ["persona.power.bullets.1", "persona.power.bullets.2", "persona.power.bullets.3", "persona.power.bullets.4"],
  },
];

const demoFlow = [
  { n: "01", title: "demo.flow.1.title", body: "demo.flow.1.body" },
  { n: "02", title: "demo.flow.2.title", body: "demo.flow.2.body" },
  { n: "03", title: "demo.flow.3.title", body: "demo.flow.3.body" },
];

// What's-new-in-v0.12 section: four highlight cards. Same card shape as
// features but with a "v0.12" version chip and a denser tech-paragraph
// body (these are about what changed, not what exists).
const whatsnew = [
  { v: "v0.71", title: "whatsnew.gpu71.title",      body: "whatsnew.gpu71.body" },
  { v: "v0.68", title: "whatsnew.window68.title",   body: "whatsnew.window68.body" },
  { v: "v0.68", title: "whatsnew.host68.title",     body: "whatsnew.host68.body" },
  { v: "v0.66", title: "whatsnew.park66.title",     body: "whatsnew.park66.body" },
  { v: "v0.64", title: "whatsnew.cjk64.title",      body: "whatsnew.cjk64.body" },
  { v: "v0.63", title: "whatsnew.core63.title",     body: "whatsnew.core63.body" },
  { v: "v0.61", title: "whatsnew.kernel61.title",   body: "whatsnew.kernel61.body" },
];

// Agent Cockpit (v0.55 headline): five pillars, one band. Icons stay
// emoji (rendered by the browser, not the terminal font).
const cockpit = [
  { icon: "🛰️", title: "cockpit.state.title",  body: "cockpit.state.body" },
  { icon: "📥", title: "cockpit.inbox.title",  body: "cockpit.inbox.body" },
  { icon: "🚀", title: "cockpit.fleet.title",  body: "cockpit.fleet.body" },
  { icon: "🔍", title: "cockpit.review.title", body: "cockpit.review.body" },
  { icon: "🔌", title: "cockpit.api.title",    body: "cockpit.api.body", wide: true },
];


const principles = [
  { n: "01", title: "principles.local.title",        body: "principles.local.body" },
  { n: "02", title: "principles.outside.title",      body: "principles.outside.body" },
  { n: "03", title: "principles.mcp.title",          body: "principles.mcp.body" },
  { n: "04", title: "principles.parity.title",       body: "principles.parity.body" },
  { n: "05", title: "principles.subtraction.title",  body: "principles.subtraction.body" },
  { n: "06", title: "principles.subscription.title", body: "principles.subscription.body", wide: true },
];

// TL;DR spec rows — keep parallel to SoloMD's "what X is, in 60 seconds" table.
// Each row is one quoted fact a skeptical reader can verify in the source or
// GitHub Releases.  `valueRaw` is rendered as-is (mixed locale fragments like
// version + date); plain `value` is an i18n key that goes through t().
const tldrRows = [
  { label: "tldr.version",         valueRaw: `${releaseTag} · ${releaseDate} · MIT` },
  { label: "tldr.bundled_agents",  value:    "tldr.bundled_agents.value" },
  { label: "tldr.price",        value: "tldr.price.value" },
  { label: "tldr.platforms",    value: "tldr.platforms.value" },
  { label: "tldr.size",         value: "tldr.size.value" },
  { label: "tldr.memory",       value: "tldr.memory.value" },
  { label: "tldr.languages",    value: "tldr.languages.value" },
  { label: "tldr.surfaces",     value: "tldr.surfaces.value" },
  { label: "tldr.engine",       value: "tldr.engine.value" },
  { label: "tldr.privacy",      value: "tldr.privacy.value" },
  { label: "tldr.engine_stack", value: "tldr.engine_stack.value" },
];

// "Where Unterm stands out" — 3 strongest differentiators with version chips.
// SoloMD does the same after the comparison table; we mirror it here as a
// confidence section after Features.
const standouts = [
  { v: "v0.18", icon: "🤖", title: "stand.agents.title",   body: "stand.agents.body" },
  { v: "v0.17", icon: "🪟", title: "stand.split.title",    body: "stand.split.body" },
  { v: "v0.16", icon: "👁️", title: "stand.audit.title",    body: "stand.audit.body" },
];

// Quality-of-life touches — minor but delightful features. Pure 4-column grid
// of icon + short title + 1-sentence body. SoloMD has the same band after
// its main feature grid for non-headline polish.
// Mouse flow — the right-click copy/paste gesture band. Three steps,
// one gesture; macOS Ctrl+click is the same gesture per platform
// convention. Verified end-to-end on macOS (v0.57.1).
const mouseFlow = [
  { icon: "🖱️", title: "mouse.copy.title",  body: "mouse.copy.body" },
  { icon: "📥", title: "mouse.paste.title", body: "mouse.paste.body" },
  { icon: "⌃",  title: "mouse.ctrl.title",  body: "mouse.ctrl.body" },
];

const qol = [
  { icon: "👻", title: "qol.ghost.title",      body: "qol.ghost.body" },
  { icon: "✨", title: "qol.suggest.title",    body: "qol.suggest.body" },
  { icon: "📋", title: "qol.copy.title",       body: "qol.copy.body" },
  { icon: "🎨", title: "qol.themes.title",     body: "qol.themes.body" },
  { icon: "📁", title: "qol.finder.title",     body: "qol.finder.body" },
  { icon: "🪪", title: "qol.profiles.title",   body: "qol.profiles.body" },
  { icon: "🚦", title: "qol.proxy.title",      body: "qol.proxy.body" },
  { icon: "🌐", title: "qol.headers.title",    body: "qol.headers.body" },
];

// Sponsor methods — mirrors SoloMD's "Support" band at the page bottom.
// Three named channels: GitHub Sponsors (international), PayPal (Chinese-
// diaspora-friendly worldwide one-tap), and a QR pair (Alipay / WeChat Pay)
// rendered later as a single card holding both images.
const sponsors = [
  { icon: "♥",  title: "sponsor.gh.title",     body: "sponsor.gh.body",     cta: "sponsor.gh.cta",     href: "https://github.com/sponsors/zhitongblog" },
  { icon: "💸", title: "sponsor.paypal.title", body: "sponsor.paypal.body", cta: "sponsor.paypal.cta", href: "https://paypal.me/solomdapp" },
];

const features = [
  { icon: "🔌", title: "features.mcp.title",    body: "features.mcp.body" },
  { icon: "⚡", title: "features.cli.title",    body: "features.cli.body" },
  { icon: "🖥️", title: "features.web.title",    body: "features.web.body" },
  { icon: "🌍", title: "features.i18n.title",   body: "features.i18n.body" },
  { icon: "🎬", title: "features.rec.title",    body: "features.rec.body" },
  { icon: "📸", title: "features.shot.title",   body: "features.shot.body" },
  { icon: "🌐", title: "features.proxy.title",  body: "features.proxy.body" },
  { icon: "⚙️", title: "features.engine.title", body: "features.engine.body" },
];

// Comparison matrix. Columns now grouped by lane: Unterm (agent-first),
// a native baseline (macOS Terminal.app / Windows Terminal), the paid AI
// terminal (Warp), and two free power terminals (iTerm2, Ghostty). The
// rows lead with the agent-control differentiators (top of the table)
// before the table-stakes rendering / platform rows. `native` is the new
// column; values are rendered raw except the `unterm` cell which goes
// through t() so "✗ (by design)" can be localized.
const cmpRows = [
  { row: "cmp.r.mcp",      unterm: "✓",        native: "✗",     warp: "✗",          iterm: "✗",          ghostty: "✗" },
  { row: "cmp.r.cli",      unterm: "✓",        native: "✗",     warp: "✗",          iterm: "Python API", ghostty: "✗" },
  { row: "cmp.r.agents",   unterm: "✓ ×7",     native: "✗",     warp: "✗",          iterm: "✗",          ghostty: "✗" },
  { row: "cmp.r.autowire", unterm: "✓",        native: "✗",     warp: "✗",          iterm: "✗",          ghostty: "✗" },
  { row: "cmp.r.cockpit",  unterm: "✓",        native: "✗",     warp: "~ cloud",    iterm: "✗",          ghostty: "✗" },
  { row: "cmp.r.identity", unterm: "✓",        native: "✗",     warp: "✗",          iterm: "✗",          ghostty: "✗" },
  { row: "cmp.r.instance", unterm: "✓",        native: "✗",     warp: "✗",          iterm: "✗",          ghostty: "✗" },
  { row: "cmp.r.rec",      unterm: "✓ md",     native: "✗",     warp: "~",          iterm: "✓",          ghostty: "✗" },
  { row: "cmp.r.capture",  unterm: "✓",        native: "✗",     warp: "✗",          iterm: "~",          ghostty: "✗" },
  { row: "cmp.r.rightclick", unterm: "✓ gesture", native: "menu", warp: "menu",      iterm: "menu",       ghostty: "menu" },
  { row: "cmp.r.proxy",    unterm: "✓",        native: "✗",     warp: "✗",          iterm: "✗",          ghostty: "✗" },
  { row: "cmp.r.local",    unterm: "✓",        native: "✓",     warp: "✗",          iterm: "✓",          ghostty: "✓" },
  { row: "cmp.r.ai",       unterm: "cmp.intentional", native: "✗", warp: "✓ (cloud)", iterm: "plugin",  ghostty: "✗" },
  { row: "cmp.r.gpu",      unterm: "✓",        native: "✗",     warp: "✓",          iterm: "✓",          ghostty: "✓" },
  { row: "cmp.r.cross",    unterm: "✓",        native: "✗",     warp: "✓",          iterm: "macOS",      ghostty: "mac+Linux" },
  { row: "cmp.r.oss",      unterm: "✓ MIT",    native: "✗",     warp: "✗",          iterm: "✓ GPL",      ghostty: "✓ MIT" },
  { row: "cmp.r.i18n",     unterm: "✓ ×9",     native: "OS",    warp: "en",         iterm: "en",         ghostty: "en" },
  { row: "cmp.r.price",    unterm: "$0",       native: "$0",    warp: "cmp.freemium", iterm: "$0",       ghostty: "$0" },
];

// Complete capability catalog — every MCP namespace + the CLI surface,
// grouped into families. `meta` is the language-neutral count chip;
// `items` are method/command names (never translated). title + body
// are i18n keys. This is the "what does it actually expose" section the
// thin 8-card Features grid only gestures at.
const capStats = [
  { n: "151", label: "cap.stat.methods" },
  { n: "30", label: "cap.stat.namespaces" },
  { n: "37", label: "cap.stat.cli" },
  { n: "4",  label: "cap.stat.surfaces" },
  { n: "22ms", label: "cap.stat.startup" },
  { n: "~12k", label: "cap.stat.kernel" },
];
const capabilities = [
  { icon: "🛩️", title: "cap.cockpit.title", body: "cap.cockpit.body", meta: "cockpit · fleet.* · review.* · 11", items: "agent.status · cockpit.inbox · fleet.launch · fleet.retry · review.verify · review.diff · review.merge · review.rollback", wide: true },
  { icon: "🪟", title: "cap.session.title",  body: "cap.session.body",  meta: "session.* · 27", items: "create · split · focus · resize · input · destroy · history · idle · cwd" },
  { icon: "👁️", title: "cap.screen.title",   body: "cap.screen.body",   meta: "screen.* · 8",   items: "text · scrollback_text · search · cursor · detect_errors · scroll" },
  { icon: "▶️", title: "cap.exec.title",     body: "cap.exec.body",     meta: "exec.* · 5",     items: "run · run_wait · send · status · cancel · signal.send" },
  { icon: "🤖", title: "cap.agents.title",   body: "cap.agents.body",   meta: "agent · 7 CLIs", items: "install · auth · launch · config · mcp-stdio bridge" },
  { icon: "🪪", title: "cap.identity.title", body: "cap.identity.body", meta: "profile · 7 sniffers", items: "list · current · create · switch · delete" },
  { icon: "🛰️", title: "cap.instance.title", body: "cap.instance.body", meta: "instance.* · 8", items: "list · info · focus · set_title" },
  { icon: "🎬", title: "cap.rec.title",      body: "cap.rec.body",      meta: "recording · asciicast", items: "recording_start · stop · status · list · read · export_markdown" },
  { icon: "📸", title: "cap.capture.title",  body: "cap.capture.body",  meta: "capture.* · 6 + upload", items: "screen · window · select · clipboard · scrollback · window_scroll · upload.file" },
  { icon: "🌐", title: "cap.proxy.title",    body: "cap.proxy.body",    meta: "proxy.* · 12",   items: "status · switch · nodes · speedtest · configure · disable · env" },
  { icon: "🛡️", title: "cap.gov.title",      body: "cap.gov.body",      meta: "governance · 9", items: "audit_log · policy.check/set · agent.identify · selftest.run · server.health" },
  { icon: "💾", title: "cap.workspace.title",body: "cap.workspace.body",meta: "workspace.* · 3",items: "save · restore · list" },
  { icon: "📖", title: "cap.meta.title",     body: "cap.meta.body",     meta: "meta.surface", items: "reference · show-keys · settings · theme · lang" },
];

---

<section class="pt-16 pb-6">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-50 text-balance">{t("features.page.title")}</h1>
    <p class="mt-4 text-lg text-notion-muted text-balance">{t("features.page.sub")}</p>
    <p class="mt-6 text-sm"><a href={pathPrefix + "/guide"} class="text-notion-teal hover:underline">{t("home.more.cta")} →</a></p>
  </div>
</section>

<!-- ============== TL;DR ============== -->
<!-- A scannable 2-column specs table.  Mirrors SoloMD's "TL;DR — what X
     is, in 60 seconds" band.  Every value is a fact a skeptical visitor
     can verify (in the source, on GitHub Releases, or in the running app).
     Sits between hero and tagline so a fast reader gets the elevator
     pitch before the long prose. -->
<section class="py-16 border-t border-notion-border">
  <div class="max-w-4xl mx-auto px-6">
    <div class="flex items-baseline gap-3 mb-6">
      <h2 class="text-xl font-semibold tracking-tight text-notion-ink">{t("tldr.title")}</h2>
      <span class="text-xs text-notion-faint font-mono">{t("tldr.subtitle")}</span>
    </div>
    <div class="rounded-xl border border-notion-border bg-notion-surface/30 overflow-hidden">
      <dl class="divide-y divide-zinc-800/60">
        {tldrRows.map((r) => (
          <div class="grid grid-cols-1 sm:grid-cols-[180px_1fr] gap-x-6 gap-y-1 px-5 py-3">
            <dt class="text-xs sm:text-sm text-notion-faint font-mono">{t(r.label)}</dt>
            <dd class="text-sm text-notion-ink leading-relaxed" set:html={r.valueRaw ?? t(r.value)}></dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<!-- ============== AGENT LAUNCHER (v0.18 hero section) ==============
     Sits right after TL;DR so visitors who scroll past the hero see the
     v0.18 story before any of the older v0.16/v0.17 angles. Mirrors the
     SoloMD pattern of "feature-grid card with screenshot on the right"
     so the page rhythm stays consistent. -->
<section id="agents" class="py-20 border-t border-notion-border bg-gradient-to-b from-notion-bg/20 via-notion-bg to-notion-bg">
  <div class="max-w-6xl mx-auto px-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-900/25 border border-amber-800/40 text-xs text-notion-teal mb-4">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-notion-teal animate-pulse"></span>
      <span set:html={t("agents.tag")}></span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-notion-ink leading-tight max-w-3xl">{t("agents.title")}</h2>
    <p class="mt-4 text-lg text-notion-muted leading-relaxed max-w-3xl" set:html={t("agents.subtitle")}></p>

    <!-- Five agent cards in a horizontal strip. Each shows vendor name, the
         install command, and an auth-mode summary. Pure HTML, no JS. -->
    <!-- Five agent cards. We hard-code dot color classes per agent because
         Tailwind's JIT scanner can't see `bg-${a.color}-400` interpolated
         strings — it only picks up classes that appear literally somewhere
         in the source. Listed verbatim below: bg-amber-400 bg-notion-teal
         bg-sky-400 bg-violet-400 bg-rose-400. -->
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {[
        { id: "claude-code", name: "Claude Code",  vendor: "Anthropic",    dot: "bg-amber-400",   modes: "OAuth · BYO key · gateway" },
        { id: "codex-cli",   name: "Codex CLI",    vendor: "OpenAI",       dot: "bg-notion-teal", modes: "ChatGPT OAuth · BYO key · gateway" },
        { id: "gemini-cli",  name: "Gemini CLI",   vendor: "Google",       dot: "bg-sky-400",     modes: "Google OAuth · BYO key · Vertex" },
        { id: "opencode",    name: "OpenCode",     vendor: "SST",          dot: "bg-violet-400",  modes: "BYO key · local" },
        { id: "aider",       name: "Aider",        vendor: "Open-source",  dot: "bg-rose-400",    modes: "BYO key · local" },
      ].map((a) => (
        <div class="rounded-xl border border-notion-border bg-notion-surface/60 p-4 hover:border-notion-borderStrong transition">
          <div class="flex items-center gap-2 mb-2">
            <span class={`inline-block h-2 w-2 rounded-full ${a.dot}`}></span>
            <div class="text-sm font-semibold text-notion-ink">{a.name}</div>
          </div>
          <div class="text-xs text-notion-faint mb-3">{a.vendor}</div>
          <div class="text-[11px] text-notion-muted font-mono leading-snug">{a.modes}</div>
        </div>
      ))}
    </div>

    <!-- 3 bullet "what you get" cards underneath -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-xl border border-notion-border bg-notion-surface/40 p-5">
        <div class="text-notion-teal text-xs font-mono mb-2">01 · one click</div>
        <h3 class="text-base font-semibold text-notion-ink mb-1">{t("agents.card.install.title")}</h3>
        <p class="text-sm text-notion-muted leading-relaxed" set:html={t("agents.card.install.body")}></p>
      </div>
      <div class="rounded-xl border border-notion-border bg-notion-surface/40 p-5">
        <div class="text-notion-teal text-xs font-mono mb-2">02 · subscription-safe</div>
        <h3 class="text-base font-semibold text-notion-ink mb-1">{t("agents.card.auth.title")}</h3>
        <p class="text-sm text-notion-muted leading-relaxed" set:html={t("agents.card.auth.body")}></p>
      </div>
      <div class="rounded-xl border border-notion-border bg-notion-surface/40 p-5">
        <div class="text-notion-teal text-xs font-mono mb-2">03 · signed catalog</div>
        <h3 class="text-base font-semibold text-notion-ink mb-1">{t("agents.card.signed.title")}</h3>
        <p class="text-sm text-notion-muted leading-relaxed" set:html={t("agents.card.signed.body")}></p>
      </div>
    </div>
  </div>
</section>

<!-- ============== TAGLINE ============== -->
<section class="py-20 border-t border-notion-border">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-notion-ink leading-tight">{t("tagline.title")}</h2>
    <p class="mt-6 text-lg text-notion-muted leading-relaxed" set:html={t("tagline.body")}></p>
  </div>
</section>

<!-- ============== DEMO ============== -->
<section id="demo" class="py-20 border-t border-notion-border bg-notion-bg">
  <div class="max-w-6xl mx-auto px-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-notion-surface/80 border border-notion-border text-xs text-notion-muted">
