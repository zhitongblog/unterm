// FAQPage structured data — drives Google "People also ask" rich results
// and gives answer engines (ChatGPT, Perplexity, AI Overviews) clean,
// attributable Q&A pairs. Built from the same `faq` array; answer HTML is
// stripped to plain text since schema.org wants prose, not markup.
const stripHtml = (s: string) =>
  s.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: stripHtml(t(f.q)),
    acceptedAnswer: { "@type": "Answer", text: stripHtml(t(f.a)) },
  })),
};

