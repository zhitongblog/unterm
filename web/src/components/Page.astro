          <a href={winZipUrl}
             class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono bg-notion-sunken/60 hover:bg-notion-sunken text-notion-ink hover:text-notion-ink border border-notion-borderStrong/50 hover:border-notion-borderStrong transition">
            portable .zip →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

