        <div class="mt-3 text-xs text-notion-green group-hover:text-notion-teal">{t("install.macos.action")}</div>
      </a>

      <!-- Linux — two artifacts: .deb + AppImage -->
      <div class="bg-notion-surface/60 hover:bg-notion-surface border border-notion-border hover:border-notion-borderStrong rounded-xl p-5 transition flex flex-col">
        <div class="flex items-center justify-between">
          <div class="text-3xl">🐧</div>
          <span class="text-xs font-mono text-notion-faint">{t("install.linux.size")}</span>
