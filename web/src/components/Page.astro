        <div class="mt-3 font-semibold">{t("install.linux.title")}</div>
        <div class="text-sm text-notion-muted mt-1 flex-1">{t("install.linux.detail")}</div>
        <div class="mt-3 flex flex-wrap gap-2">
          <a href={debUrl}
             class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono bg-notion-green/10 hover:bg-notion-green/20 text-notion-teal hover:text-notion-teal border border-notion-green/20 hover:border-notion-green/40 transition">
            .deb →
          </a>
          <a href={appimageUrl}
             class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono bg-notion-sunken/60 hover:bg-notion-sunken text-notion-ink hover:text-notion-ink border border-notion-borderStrong/50 hover:border-notion-borderStrong transition">
            .AppImage →
          </a>
        </div>
      </div>

      <!-- Windows — two artifacts: MSI + portable .zip -->
      <div class="bg-notion-surface/60 hover:bg-notion-surface border border-notion-border hover:border-notion-borderStrong rounded-xl p-5 transition flex flex-col">
        <div class="flex items-center justify-between">
          <div class="text-3xl">🪟</div>
          <span class="text-xs font-mono text-notion-faint">{t("install.windows.size")}</span>
        </div>
