    <!-- Five agent cards in a horizontal strip. Each shows vendor name, the
         install command, and an auth-mode summary. Pure HTML, no JS. -->
    <!-- Five agent cards. We hard-code dot color classes per agent because
         Tailwind's JIT scanner can't see `bg-${a.color}-400` interpolated
