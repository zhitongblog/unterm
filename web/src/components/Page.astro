      </div>

      <div class="install-pane" data-pane="unix">
        <pre class="font-mono text-sm text-notion-ink px-5 py-5 overflow-x-auto"><code>curl -fsSL https://unterm.app/install.sh | sh</code></pre>
        <p class="text-xs text-notion-faint px-5 pb-4" set:html={t("install.unix_detail")}></p>
      </div>
      <div class="install-pane hidden" data-pane="win">
        <pre class="font-mono text-sm text-notion-ink px-5 py-5 overflow-x-auto"><code>irm https://unterm.app/install.ps1 | iex</code></pre>
