         in the source. Listed verbatim below: bg-amber-400 bg-notion-teal
         bg-sky-400 bg-violet-400 bg-rose-400. -->
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {[
        { id: "claude-code", name: "Claude Code",  vendor: "Anthropic",    dot: "bg-amber-400",   modes: "OAuth · BYO key · gateway" },
        { id: "codex-cli",   name: "Codex CLI",    vendor: "OpenAI",       dot: "bg-notion-teal", modes: "ChatGPT OAuth · BYO key · gateway" },
        { id: "gemini-cli",  name: "Gemini CLI",   vendor: "Google",       dot: "bg-sky-400",     modes: "Google OAuth · BYO key · Vertex" },
        { id: "opencode",    name: "OpenCode",     vendor: "SST",          dot: "bg-violet-400",  modes: "BYO key · local" },
        { id: "aider",       name: "Aider",        vendor: "Open-source",  dot: "bg-rose-400",    modes: "BYO key · local" },
      ].map((a) => (
        <div class="rounded-xl border border-notion-border bg-notion-surface/60 p-4 hover:border-notion-borderStrong transition">
          <div class="flex items-center gap-2 mb-2">
            <span class={`inline-block h-2 w-2 rounded-full ${a.dot}`}></span>
            <div class="text-sm font-semibold text-notion-ink">{a.name}</div>
          </div>
          <div class="text-xs text-notion-faint mb-3">{a.vendor}</div>
          <div class="text-[11px] text-notion-muted font-mono leading-snug">{a.modes}</div>
        </div>
      ))}
    </div>

    <!-- 3 bullet "what you get" cards underneath -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-xl border border-notion-border bg-notion-surface/40 p-5">
